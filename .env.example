# Telegram Bot API Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Optional but recommended: your numeric Telegram user id (get it from @userinfobot).
# When set, the bot only responds to you and ignores everyone else.
ALLOWED_TELEGRAM_USER_ID=""

# Supabase Credentials (Get these from supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Gemini API Key (Get this from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Timezone used for reminders, schedules and diary dates (default: Asia/Kolkata)
APP_TIMEZONE="Asia/Kolkata"

# Time for the daily morning briefing scorecard push (default: 05:00:00 for 5:00 AM)
MORNING_BRIEFING_TIME="05:00:00"

# Optional: chat id that should receive reminders. If empty, the bot auto-detects
# the most recently active chat (fine for a single-user bot).
TELEGRAM_DEFAULT_CHAT_ID=""

# Secret for the cron endpoints (/api/remind?key=... and /api/tick?key=...).
# Leave empty for local dev; set it on Vercel and in your cron service URLs.
CRON_SECRET=""

# =============================================================================
# Automated Daily Summary Email (100% Free - Zero cost)
# Sent automatically every morning with previous day's debrief (focus time,
# tasks, projects, completed accomplishments, and incomplete to-dos).
# =============================================================================
# Recipient email address
SUMMARY_EMAIL_TO=""

# Optional custom sender address (e.g. LifeLog <onboarding@resend.dev> or your Gmail)
SUMMARY_EMAIL_FROM=""

# Option A: Resend Free API (3,000 free emails/month - recommended for Vercel)
# Get a free API key at https://resend.com (zero cost, no credit card required)
RESEND_API_KEY=""

# Option B: Gmail / Standard SMTP (100% Free with standard Google App Password)
# Google accounts can send up to 500 emails/day for free.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"


